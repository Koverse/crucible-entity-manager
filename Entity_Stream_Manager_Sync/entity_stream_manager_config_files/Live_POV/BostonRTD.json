{
    "correlation_type": "Dynamic object creation",
    "crucible_tracker": "passthrough",
    "custom_functions": [
        {
            "function_name": "set_edh"
        },
        {
            "function_name": "set_measurement_errors"
        }
    ],
    "destination_unique_ID_column": "identity.dynamicIdentifier",
    "disabled": false,
    "num_tracker_workers": 3,
    "origin_dataset": "BostonRTD",
    "origin_to_destination_mapping": [
        {
            "destination_column": "geodetic.latitude",
            "origin_column": "vehicle.position.latitude"
        },
        {
            "destination_column": "geodetic.longitude",
            "origin_column": "vehicle.position.longitude"
        },
        {
            "destination_column": "estimatedKinematics.kinematicsTimestamp",
            "origin_column": "vehicle.timestamp"
        },
        {
            "destination_column": "uncertainty.uncertaintyEllipse.orientation",
            "origin_column": "position_orientation"
        },
        {
            "destination_column": "uncertainty.uncertaintyEllipse.semiMajorAxisLength",
            "origin_column": "position_semimajor"
        },
        {
            "destination_column": "uncertainty.uncertaintyEllipse.semiMinorAxisLength",
            "origin_column": "position_semiminor"
        },
        {
            "destination_column": "mode",
            "literal": "LIVE"
        },
        {
            "destination_column": "identity.environment",
            "literal": "GROUND"
        },
        {
            "destination_column": "identity.standard",
            "literal": "ASSUMED_FRIEND"
        },
        {
            "destination_column": "identity.allegiance",
            "literal": "USA"
        },
        {
            "destination_column": "edhControlSet",
            "origin_column": "defaultEDH"
        }
    ],
    "origin_unique_ID_column": "vehicle.vehicle.id",
    "perspective": "Live_POV",
    "query": "SELECT * FROM BostonRTD WHERE BostonRTD.vehicle.vehicle.id IS NOT NULL AND CAST(BostonRTD.vehicle.vehicle.id AS VARCHAR) <> '' AND BostonRTD.vehicle.`timestamp` IS NOT NULL AND BostonRTD.vehicle.`position`.latitude IS NOT NULL AND BostonRTD.vehicle.`position`.longitude IS NOT NULL AND BostonRTD.vehicle.`timestamp` <> 0",
    "skip_ECEF_conversion": false,
    "unit_conversions": [
        {
            "origin_column": "vehicle.position.latitude",
            "unit_conversion": "degrees_to_radians"
        },
        {
            "origin_column": "vehicle.position.longitude",
            "unit_conversion": "degrees_to_radians"
        },
        {
            "origin_column": "vehicle.timestamp",
            "unit_conversion": "sec_to_ISO8601"
        }
    ],
    "custom_function_api_version": 2,
    "number_of_transformer_processes": 3,
    "batch_update_chunk_size": "1000",
    "batch_write_chunk_size": "5000",
    "batch_write_max_concurrent": 1,
    "component_track_event_dataset": "Live_POV_ComponentTrackEvents",
    "component_track_head_dataset": "Live_POV_ComponentTrackHeads",
    "entity_management_event_dataset": "Live_POV_EntityManagementEvents",
    "head_update_interval_seconds": 30,
    "principal_track_event_dataset": "Live_POV_PrincipalTrackEvents",
    "principal_track_head_dataset": "Live_POV_PrincipalTrackHeads",
    "report_event_dataset": "Live_POV_ReportEvents",
    "skip_head_preload": true,
    "use_numpy_fusion": true,
    "use_numpy_kalman": true
}
